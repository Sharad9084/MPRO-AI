{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{sample-*.csv,backend/mpro_reconciliation.db}"
    }
  },
  "rewrites": [
    {
      "source": "/api/extracted-data/:source",
      "destination": "/api/extracted-data.py"
    }
  ]
}
